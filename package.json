{
	"name": "@sirosfoundation/browser-log",
	"description": "Pretty browser logs for browser-based apps",
	"version": "0.1.0-beta.4",
	"license": "BSD-2-Clause",
	"type": "module",
	"types": "./dist/logger.d.mts",
	"main": "./dist/logger.cjs",
	"module": "./dist/logger.mjs",
	"exports": {
		".": {
			"types": "./dist/logger.d.mts",
			"import": "./dist/logger.mjs",
			"require": "./dist/logger.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist/",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest run",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"dotenv-cli": "^11.0.0",
		"jsdom": "^30.0.0",
		"tsdown": "^0.22.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.7"
	},
	"homepage": "https://github.com/sirosfoundation/browser-log#readme",
	"repository": "github:sirosfoundation/browser-log",
	"packageManager": "pnpm@10.4.0"
}
